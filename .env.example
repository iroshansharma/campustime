# ==============================================================================
# CampusTime Environment Configuration Template
# ==============================================================================

# Backend Settings (Django)
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
# Development fallback: If DATABASE_URL is not set or PostgreSQL is unavailable,
# the backend will fall back to local SQLite (db.sqlite3) with a logged warning.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campustime_db
DB_ENGINE=django.db.backends.postgresql
DB_NAME=campustime_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS & Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Timetable Engine Settings
SCHEDULER_TIMEOUT_SECONDS=60
SCHEDULER_MAX_BACKTRACK_STEPS=50000

# Frontend Settings (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_TITLE="CampusTime — Smart Timetable System"

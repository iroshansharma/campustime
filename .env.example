# ==============================================================================
# CampusTime Environment Configuration Template
# ==============================================================================

# Backend Settings (Django)
# For local dev: DEBUG=True. For Render production: DEBUG=False
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
# In production on Render: ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL / Neon)
# Local development fallback: If USE_SQLITE=True or DATABASE_URL is unset,
# the backend uses local db.sqlite3.
USE_SQLITE=True
# Production (Neon PostgreSQL): Set USE_SQLITE=False and provide your Neon connection string:
# Format: postgresql://<user>:<password>@<endpoint-id>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campustime_db

# CORS & Security
# Local: http://localhost:5173,http://127.0.0.1:5173
# Production (Vercel): http://localhost:5173,https://<your-app>.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to True only if troubleshooting cross-origin access during staging:
CORS_ALLOW_ALL_ORIGINS=False

# CSRF Trusted Origins (Required by Django 4+ in production behind reverse proxies)
# Production: http://localhost:5173,https://<your-app>.vercel.app,https://<your-backend>.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Timetable Engine Settings
SCHEDULER_TIMEOUT_SECONDS=60
SCHEDULER_MAX_BACKTRACK_STEPS=50000

# Frontend Settings (Vite / Vercel)
# Local: http://127.0.0.1:8000/api/v1
# Production (Vercel): https://<your-backend>.onrender.com/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_TITLE="CampusTime — Smart Timetable System"
